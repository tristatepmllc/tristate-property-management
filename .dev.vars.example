# copy to .dev.vars for local `wrangler dev` (git-ignored)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFY_TO=service@tristatepropertymanagement.com
LEAD_NOTIFY_FROM=Tristate Website <noreply@tristatepropertymanagement.com>
# Signs and verifies session cookies. Any long random string works locally;
# generate one with: openssl rand -base64 32
# In production this is a Worker secret, never a wrangler.jsonc var:
#   npx wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=dev-only-secret-change-me
