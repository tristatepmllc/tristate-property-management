{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tristate-property-management",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Astro 7 / adapter 14 unified entrypoint. Do NOT point this at
  // ./dist/_worker.js/index.js — that file does not exist before the first
  // build and the Cloudflare vite plugin resolves this at config time.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // --- D1 -------------------------------------------------------------
  // Schema lives in ./db/schema.sql and is idempotent (CREATE TABLE IF NOT
  // EXISTS throughout), so re-running it against a live database is safe.
  //   npx wrangler d1 execute tristate-db --remote --file=./db/schema.sql
  // GET /api/health reports which tables the binding can actually see.
  "d1_databases": [
    { "binding": "DB", "database_name": "tristate-db", "database_id": "693e64bc-7f00-4254-92b9-53e614c10a45" }
  ],

  // --- R2 (scaffolded for future job photos) --------------------------
  // npx wrangler r2 bucket create tristate-media
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tristate-media" }
  ],

  // Secrets are NOT stored here:
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    "LEAD_NOTIFY_TO": "service@tristatepropertymanagement.com",
    "LEAD_NOTIFY_FROM": "Tristate Website <noreply@tristatepropertymanagement.com>"
  }
}
