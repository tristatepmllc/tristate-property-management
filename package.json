{
  "name": "tristate-property-management",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check",
    "db:local": "wrangler d1 execute tristate-db --local --file=./db/schema.sql",
