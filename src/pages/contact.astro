---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadFormExtras from '../components/LeadFormExtras.astro';
import { SITE, SERVED_SENTENCE, SERVED_ABBR } from '../data/site';
import Coverage from '../components/Coverage.astro';
import { graph, breadcrumbs } from '../lib/schema';

const jsonLd = graph([breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }])]);
---
<BaseLayout
  title="Request a Free Quote - Written Price Same Day"
  description="Tell us what needs fixing and get a flat, written quote, usually the same business day. Emergency? Call (708) 905-4471 - answered by a person, 24 hours a day."
  path="/contact/"
  active="/contact/"
  jsonLd={jsonLd}
  showPopup={false}
>
<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/images/industries-automotive.webp')"></div>
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <span>Contact</span></p>
    <h1>Tell us what needs fixing</h1>
    <p>
      Send it before noon on a working day and you will have a written price back the same
      day. If it is an emergency, call - the phone is faster than any form.
    </p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="contact-grid contact-grid--reverse">

      <!-- INFO (left, Lessen layout) -->
      <div>
        <p class="eyebrow">Contact Tristate</p>
        <h2 style="font-size:1.9rem;text-transform:uppercase;margin-bottom:8px">How may we help you?</h2>
        <p style="color:var(--steel);font-size:.93rem;margin-bottom:26px">
          Fill in the form and we'll get back to you, usually the same business day. Prefer to
          talk now? Call <a href={SITE.telHref}>{SITE.phone}</a>.
        </p>

        <div class="info-block">
          <h3>Contact details</h3>
          <div class="info-row">
            <span class="k">Phone</span>
            <span class="v"><a href={SITE.telHref}>{SITE.phone}</a></span>
          </div>
          <div class="info-row">
            <span class="k">Email</span>
            <span class="v"><a href={SITE.mailtoHref}>{SITE.email}</a></span>
          </div>
          <div class="info-row">
            <span class="k">{SITE.address.street ? 'Office' : 'Serving'}</span>
            <span class="v">
              {SITE.address.street
                ? <>{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postal}</>
                : <>{SERVED_ABBR}<br />We come to you - no walk-in office</>}
            </span>
          </div>
        </div>

        <div class="info-block">
          <h3>Hours</h3>
          <div class="info-row"><span class="k">Mon&ndash;Fri</span><span class="v">7:00 AM &ndash; 6:00 PM</span></div>
          <div class="info-row"><span class="k">Saturday</span><span class="v">8:00 AM &ndash; 2:00 PM</span></div>
          <div class="info-row"><span class="k">Sunday</span><span class="v">Emergency dispatch only</span></div>
          <div class="info-row"><span class="k">Emergency</span><span class="v">24 / 7 / 365</span></div>
        </div>

        <div class="info-block">
          <h3>Coverage</h3>
          <p style="font-size:.9rem;color:var(--steel);margin-bottom:14px">
            We cover {SERVED_SENTENCE}:
          </p>
          <Coverage columns="1fr 1fr" />
        </div>

        <div class="emergency-card" id="emergency" style="margin-top:18px">
          <h3>Emergency? Call, don't type</h3>
          <p>
            Active leaks, no power, no heat or cooling, broken glass, sewage backup or a
            blocked fire exit - the line is answered by a person who can dispatch a crew,
            24 hours a day.
          </p>
          <a class="big" href={SITE.telHref}>{SITE.phone}</a>
        </div>
      </div>

      <!-- FORM (right, Lessen layout - fields only, no heading inside the card) -->
      <div class="form-card">
        <form action="/api/leads" method="post" data-lead-form data-source="contact-page-form"
          data-thanks-heading="Thank you for your submission!"
          data-success={`We read every request and reply with a written price, usually the same business day. Need us right now? Call ${SITE.phone}.`}
        >
          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" name="email" placeholder="jane@company.com" required>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="first_name">First Name <span class="req">*</span></label>
              <input type="text" id="first_name" name="first_name" autocomplete="given-name" placeholder="Jane" required>
            </div>
            <div class="field">
              <label for="last_name">Last Name <span class="req">*</span></label>
              <input type="text" id="last_name" name="last_name" autocomplete="family-name" placeholder="Whitfield" required>
            </div>
          </div>

          <div class="field">
            <label for="company">Company <span class="req">*</span></label>
            <input type="text" id="company" name="company" placeholder="Riverside Business Park" required>
          </div>

          <div class="field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" placeholder="(203) 000-0000">
          </div>

          <div class="field">
            <fieldset>
              <legend>Which best describes you? <span class="req">*</span></legend>
              <label><input type="radio" name="describes_you" value="Commercial property manager/owner" required /> Commercial property manager/owner</label>
              <label><input type="radio" name="describes_you" value="Residential property manager/owner" /> Residential property manager/owner</label>
            </fieldset>
          </div>

          <div class="field">
            <label for="details">Is there anything you'd like us to know?</label>
            <span style="display:block;font-size:.75rem;color:var(--steel);margin:-4px 0 7px">Optional</span>
            <textarea id="details" name="details" placeholder="Example: Second-floor men's restroom, two of three faucets dripping constantly and one flush valve running."></textarea>
          </div>

          <LeadFormExtras source="contact-page-form" />

          <button type="submit" class="btn btn--red btn--wide">Submit</button>

          <p class="form-note">
            We reply to every request. Quotes sent before noon on a business day are answered
            the same day; anything later comes back the next morning. We never pass your
            details to a third party.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>
<!-- ================= REASSURANCE ================= -->
<section class="section section--tight section--paper">
  <div class="wrap">
    <div class="stats">
      <div class="stat">
        <div class="stat-num">Free</div>
        <div class="stat-label">Quotes &amp; site visits</div>
      </div>
      <div class="stat">
        <div class="stat-num">Same<em>-day</em></div>
        <div class="stat-label">Written pricing</div>
      </div>
      <div class="stat">
        <div class="stat-num">30<em>-day</em></div>
        <div class="stat-label">Workmanship guarantee</div>
      </div>
      <div class="stat">
        <div class="stat-num">24<em>/7</em></div>
        <div class="stat-label">Emergency dispatch</div>
      </div>
    </div>
  </div>
</section>

<section class="cta-band cta-band--photo cta-band--fractured">
  <div class="cta-bg" style="background-image:url('/images/home-offices.webp')"></div>
  <svg class="cta-fracture" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon class="frac-plate" points="0,400 1440,400 1440,362 1306,382 1178,344 1012,370 872,322 706,346 566,300 432,324 268,270 176,292 0,262" />
    <path class="frac-line" d="M0,262 L176,292 L268,270 L432,324 L566,300 L706,346 L872,322 L1012,370 L1178,344 L1306,382 L1440,362" />
    <path class="frac-branch" d="M432,324 L466,262 L450,222" />
    <path class="frac-branch" d="M872,322 L842,380 L860,400" />
    <path class="frac-branch" d="M176,292 L152,350" />
    <path class="frac-branch" d="M1178,344 L1206,296" />
    <path class="frac-branch frac-branch--fine" d="M706,346 L680,394" />
    <path class="frac-branch frac-branch--fine" d="M566,300 L588,254" />
  </svg>
  <div class="wrap">
    <div class="cta-inner">
      <div>
        <h2>Prefer to just talk it through?</h2>
        <p>Call and describe the problem. Most jobs can be priced over the phone in a few minutes.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--red" href={SITE.telHref}>Call {SITE.phone}</a>
        <a class="btn btn--ghost" href="/services/">Browse services</a>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
