---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, SERVICE_CATEGORIES, SERVED_SENTENCE } from '../../data/site';
import { graph, breadcrumbs, service, faqPage } from '../../lib/schema';

/**
 * One page per service category.
 *
 * The route is keyed on `data.category`, not on the filename, so a content file
 * cannot quietly publish at a slug that has no matching SERVICE_CATEGORIES
 * entry - that would produce a page the nav, the catalogue and the Service
 * schema all disagree about. The zod enum in content.config.ts is the first
 * guard; this is the second.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('services', ({ data }) => !data.draft);
  return entries
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => ({ params: { slug: entry.data.category }, props: { entry } }));
};

type Props = { entry: CollectionEntry<'services'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const d = entry.data;

const cat = SERVICE_CATEGORIES.find((c) => c.slug === d.category)!;
const path = `/services/${d.category}/`;

// Siblings for the footer strip, in catalogue order, excluding this one.
const all = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const others = all.filter((e) => e.data.category !== d.category);

const jsonLd = graph([
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: cat.name, path },
  ]),
  service(d.category),
  faqPage(d.faqs),
]);
---
<BaseLayout
  title={d.title}
  description={d.description}
  path={path}
  active="/services/"
  ogImage={d.cover}
  ogAlt={d.coverAlt}
  preloadImage={d.cover}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="page-hero-bg" style={`background-image:url('${d.cover}')`}></div>
    <div class="wrap">
      <p class="crumb">
        <a href="/">Home</a> &nbsp;/&nbsp; <a href="/services/">Services</a> &nbsp;/&nbsp; <span>{cat.name}</span>
      </p>
      <h1>{d.h1}</h1>
      <p>{d.summary}</p>
      <div class="hero-actions" style="margin-top:24px">
        <a class="btn btn--red" href="/contact/">Request a quote</a>
        <a class="btn btn--ghost" href={SITE.telHref}>Call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <!-- ============ SCOPE ============ -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">{d.kicker}</p>
        <h2>What is in scope, and what is not</h2>
        <p>
          Most disputes about a maintenance contract are really disputes about where it
          stopped. Both halves are published here so the boundary is agreed before the work
          starts rather than argued about afterwards.
        </p>
      </div>
      <div class="scope-cols">
        <div class="scope-col">
          <h3 class="scope-h scope-h--in">Included</h3>
          <ul class="scope-list">
            {d.included.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="scope-col">
          <h3 class="scope-h scope-h--out">Not included</h3>
          <ul class="scope-list scope-list--out">
            {d.excludes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BODY ============ -->
  <section class="section section--paper">
    <div class="wrap">
      <article class="prose prose--full">
        <Content />
      </article>
    </div>
  </section>

  <!-- ============ BUILDINGS ============ -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Where this work runs</p>
        <h2>Buildings we do this in</h2>
        <p>Across {SERVED_SENTENCE}. If your building is not on the list, ask anyway.</p>
      </div>
      <div class="areas">
        {d.buildings.map((b) => <span class="area">{b}</span>)}
        <span class="area area--wide"><a href="/industries/">See all the building types we cover</a></span>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section--paper" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Straight answers</p>
        <h2>Questions we get asked first</h2>
      </div>
      <div class="faq">
        {d.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ OTHER SERVICES ============ -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">The rest of the building</p>
        <h2>Other trades we run in-house</h2>
        <p>
          The reason to have one company on the building is that the second problem is
          rarely in the same trade as the first.
        </p>
      </div>
      <div class="areas">
        {others.map((o) => {
          const c = SERVICE_CATEGORIES.find((x) => x.slug === o.data.category)!;
          return <span class="area"><a href={`/services/${o.data.category}/`}>{c.name}</a></span>;
        })}
      </div>
    </div>
  </section>

  <section class="cta-band cta-band--photo cta-band--fractured">
    <div class="cta-bg" style="background-image:url('/images/home-crew-carrying-ladders-on-a-commercial-job-si.webp')"></div>
    <svg class="cta-fracture" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <polygon class="frac-plate" points="0,400 1440,400 1440,362 1306,382 1178,344 1012,370 872,322 706,346 566,300 432,324 268,270 176,292 0,262" />
      <path class="frac-line" d="M0,262 L176,292 L268,270 L432,324 L566,300 L706,346 L872,322 L1012,370 L1178,344 L1306,382 L1440,362" />
      <path class="frac-branch" d="M432,324 L466,262 L450,222" />
      <path class="frac-branch" d="M872,322 L842,380 L860,400" />
      <path class="frac-branch" d="M176,292 L152,350" />
      <path class="frac-branch" d="M1178,344 L1206,296" />
      <path class="frac-branch frac-branch--fine" d="M706,346 L680,394" />
      <path class="frac-branch frac-branch--fine" d="M566,300 L588,254" />
    </svg>
    <div class="wrap">
      <div class="cta-inner">
        <div>
          <h2>Get a written price</h2>
          <p>Tell us the building and what it needs. A flat, written quote comes back - not an hourly estimate.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn--red" href="/contact/">Request a quote</a>
          <a class="btn btn--ghost" href={SITE.telHref}>Call {SITE.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
