---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { SITE } from '../data/site';
import { getAuth } from '../lib/auth';
import { THROTTLE_WINDOW_MS, THROTTLE_MAX } from './api/portal/request-service';
import VendorDashboard from '../components/portal/VendorDashboard.astro';
import JobHistoryTable from '../components/portal/JobHistoryTable.astro';
import CashbackLedgerTable from '../components/portal/CashbackLedgerTable.astro';
import ProfileForm from '../components/portal/ProfileForm.astro';
import AccountSettingsPanel from '../components/portal/AccountSettingsPanel.astro';

/**
 * Real login, registration and a dashboard - replacing the holding page.
 * See README ("Header menus") for why a holding page existed at all: a Login
 * control that led to a form that could not authenticate anyone was worse
 * than no Login control.
 *
 * Session check runs server-side (this page is `prerender = false`, same as
 * the API routes) so the dashboard never flashes then disappears - the HTML
 * that reaches the browser already reflects whether anyone is signed in.
 *
 * `?reset=<token>` switches the page into "set a new password" mode. That
 * token comes from the email `sendResetPassword` in src/lib/auth.ts sends;
 * it is single-use and expires in one hour, both enforced by Better Auth.
 */
const session = await getAuth().api.getSession({ headers: Astro.request.headers });
const resetToken = Astro.url.searchParams.get('reset');

type Role = 'client' | 'vendor' | 'admin';
const user = session?.user as (typeof session extends null ? never : NonNullable<typeof session>['user']) & {
  role?: Role;
  company?: string | null;
  phone?: string | null;
  address?: string | null;
  city?: string | null;
  state?: string | null;
  zip?: string | null;
  propertyType?: string | null;
  preferredContact?: string | null;
  notes?: string | null;
  trade?: string | null;
  tradesOther?: string | null;
  serviceArea?: string | null;
  licenseNumber?: string | null;
  licenseExpires?: number | null;
  insuranceOnFile?: boolean | null;
  yearsInBusiness?: string | null;
  emergencyAvailable?: boolean | null;
} | undefined;

let balanceCents = 0;
let jobCount = 0;
type JobRow = {
  id: string; service: string | null; description: string | null; status: string;
  vendor_id: string | null; vendor_response: string;
  scheduled_at: number | null; completed_at: number | null; amount_cents: number | null; created_at: number;
  invoice_status: string; invoice_amount_cents: number | null; invoice_notes: string | null;
  invoice_submitted_at: number | null; invoice_rejected_reason: string | null;
};
type LedgerRow = { id: string; job_id: string | null; amount_cents: number; reason: string; created_at: number };
let jobs: JobRow[] = [];
let ledgerEntries: LedgerRow[] = [];
let recentRequestCount = 0;

let dashboardDataError = false;

if (session) {
  try {
    const since = Date.now() - THROTTLE_WINDOW_MS;
    const [balanceRow, jobsRow, jobsList, ledgerList, throttleRow] = await Promise.all([
      env.DB.prepare(`SELECT COALESCE(SUM(amount_cents), 0) AS cents FROM cashback_ledger WHERE account_id = ?1`)
        .bind(session.user.id)
        .first<{ cents: number }>(),
      // account_id = ?1 covers a client's own jobs; vendor_id = ?1 covers jobs
      // assigned to this account as the vendor - same reasoning as
      // GET /api/jobs, kept in sync with it.
      env.DB.prepare(`SELECT COUNT(*) AS n FROM jobs WHERE account_id = ?1 OR vendor_id = ?1`)
        .bind(session.user.id)
        .first<{ n: number }>(),
      env.DB.prepare(
        `SELECT id, service, description, status, vendor_id, vendor_response, scheduled_at, completed_at, amount_cents,
                invoice_status, invoice_amount_cents, invoice_notes, invoice_submitted_at, invoice_rejected_reason, created_at
         FROM jobs WHERE account_id = ?1 OR vendor_id = ?1 ORDER BY created_at DESC LIMIT 100`
      ).bind(session.user.id).all<JobRow>(),
      env.DB.prepare(
        `SELECT id, job_id, amount_cents, reason, created_at
         FROM cashback_ledger WHERE account_id = ?1 ORDER BY created_at DESC LIMIT 200`
      ).bind(session.user.id).all<LedgerRow>(),
      // Same window/limit as POST /api/portal/request-service - computed here
      // too so the form can be hidden server-side once the same account has
      // hit it, rather than rendering a form that would just 429 on submit.
      env.DB.prepare(`SELECT COUNT(*) AS n FROM leads WHERE account_id = ?1 AND created_at > ?2`)
        .bind(session.user.id, since)
        .first<{ n: number }>(),
    ]);
    balanceCents = balanceRow?.cents ?? 0;
    jobCount = jobsRow?.n ?? 0;
    jobs = jobsList.results ?? [];
    ledgerEntries = ledgerList.results ?? [];
    recentRequestCount = throttleRow?.n ?? 0;
  } catch (e) {
    // A signed-in user must never see a raw 500 here - the auth check above
    // already succeeded, so this is specifically the D1 query layer, not
    // the session. Most likely cause in this codebase's history: a query
    // was changed to select a column a pending migration hasn't added to
    // remote D1 yet (exactly what happened shipping the invoice columns -
    // /api/health only checks table names, not columns, so it stayed green
    // while every signed-in page load 500'd). Degrade to the same empty
    // state a fresh account already renders correctly, rather than crash,
    // and say so on the page instead of just silently showing zeros.
    console.error('portal_dashboard_query_failed', String(e).slice(0, 300));
    dashboardDataError = true;
  }
}

const canRequestService = user?.role === 'client' && recentRequestCount < THROTTLE_MAX;

const balance = (balanceCents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });

// yyyy-mm-dd for <input type="date">, in the account's own stored value -
// not "today", so an empty field means "never set", not "expires today".
const licenseExpiresValue = user?.licenseExpires
  ? new Date(user.licenseExpires).toISOString().slice(0, 10)
  : '';
---
{session ? (
  <DashboardLayout title="Portal - Tristate Property Management" user={user}>
    {dashboardDataError ? (
      <div class="wrap">
        <p class="form-note" style="margin-top:16px;padding:12px 16px;background:var(--red-soft);border-radius:8px;color:var(--red-dark)">
          Your account data couldn't load just now - the numbers below may be incomplete. Try refreshing in a moment; contact us if this keeps happening.
        </p>
      </div>
    ) : null}
    {user?.role === 'vendor' ? (
      <VendorDashboard
        user={user}
        jobCount={jobCount}
        jobs={jobs}
        licenseExpiresValue={licenseExpiresValue}
      />
    ) : (
      <div class="dash-content">
        <div class="wrap">
          <div class="portal-grid">
            <div class="form-card">
              <h3>Cashback balance</h3>
              <p class="portal-figure">{balance}</p>
              <p class="form-note">
                Running total from the earn/redeem ledger. Nothing has posted to it yet for most
                accounts - that is expected until a completed job earns cashback.
              </p>
            </div>
            <div class="form-card">
              <h3>Jobs on file</h3>
              <p class="portal-figure">{jobCount}</p>
              <p class="form-note">
                {jobCount === 0
                  ? 'No jobs recorded yet. This fills in once work is scheduled against your account.'
                  : `${jobCount} job${jobCount === 1 ? '' : 's'} on record.`}
              </p>
            </div>
          </div>

          {user?.role === 'client' ? (
            <div class="form-card form-card--wide">
              <h3>Request service</h3>
              {canRequestService ? (
                <>
                  <p class="form-note">
                    Submit straight from your account instead of re-filling the public form -
                    your name, email and property go with it automatically.
                  </p>
                  <form data-lead-form action="/api/portal/request-service" data-source="portal-request-service"
                    data-thanks-heading="Request received" novalidate>
                    <div class="field">
                      <label for="rs-phone">Phone <span class="req">*</span></label>
                      <input type="tel" id="rs-phone" name="phone" autocomplete="tel" value={user?.phone || ''} required />
                    </div>
                    <div class="field">
                      <label for="rs-service">Service needed <span class="req">*</span></label>
                      <select id="rs-service" name="service" required>
                        <option value="">Choose a service&hellip;</option>
                        <option>Janitorial &amp; Cleaning</option>
                        <option>Plumbing &amp; Drains</option>
                        <option>Electrical &amp; Lighting</option>
                        <option>HVAC &amp; Refrigeration</option>
                        <option>Handyman &amp; Repairs</option>
                        <option>Painting &amp; Surfaces</option>
                        <option>Grounds &amp; Exterior</option>
                        <option>Restoration &amp; Projects</option>
                        <option>Multiple services / not sure</option>
                      </select>
                    </div>
                    <div class="field">
                      <label for="rs-urgency">How urgent?</label>
                      <select id="rs-urgency" name="urgency">
                        <option value="">Choose&hellip;</option>
                        <option>Emergency - today</option>
                        <option>Within 48 hours</option>
                        <option>This week</option>
                        <option>Planning ahead / budgeting</option>
                      </select>
                    </div>
                    <div class="field">
                      <label for="rs-details">Describe the job</label>
                      <textarea id="rs-details" name="details" placeholder="What needs fixing, and where on the property."></textarea>
                    </div>
                    <input type="hidden" name="source" value="portal-request-service" />
                    <button type="submit" class="btn btn--red">Send request</button>
                    <p class="form-status" role="status" aria-live="polite" hidden></p>
                  </form>
                </>
              ) : (
                <p class="form-note">
                  You've sent {recentRequestCount} requests in the last 24 hours - that's the limit
                  for this form. Need something urgent right now? Call <a href={SITE.telHref}>{SITE.phone}</a>,
                  answered 24/7.
                </p>
              )}
            </div>
          ) : null}

          <div class="form-card form-card--wide">
            <h3>Job history</h3>
            <JobHistoryTable jobs={jobs} />
          </div>

          <div class="form-card form-card--wide">
            <h3>Cashback ledger</h3>
            <CashbackLedgerTable entries={ledgerEntries} />
          </div>

          <div class="form-card form-card--wide" id="profile">
            <h3>Profile</h3>
            <ProfileForm user={user} licenseExpiresValue={licenseExpiresValue} />
          </div>

          <div class="form-card form-card--wide" id="settings">
            <h3>Settings</h3>
            <AccountSettingsPanel email={user?.email} />
          </div>
        </div>
      </div>
    )}
  </DashboardLayout>
) : (
  <BaseLayout
    title="Client and Vendor Portal - Tristate Property Management"
    description="Sign in to your Tristate account for job history and cashback balance, or register a new client or vendor account."
    path="/portal/"
    active="/portal/"
    noindex={true}
    showPopup={false}
  >
    <section class="page-hero">
      <div class="page-hero-bg" style="background-image:url('/images/home-site-supervisor-reviewing-building-plans-on-.webp')"></div>
      <div class="wrap">
        <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <span>Portal</span></p>
        <h1>Portal</h1>
        <p>Sign in to an existing account, or register a new one below.</p>
      </div>
    </section>

    {resetToken ? (
      <section class="section">
        <div class="wrap">
          <div class="form-card form-card--narrow">
            <h2>Set a new password</h2>
            <form data-reset-form novalidate>
              <input type="hidden" name="token" value={resetToken} />
              <div class="field">
                <label for="p-new">New password <span class="req">*</span></label>
                <input type="password" id="p-new" name="password" autocomplete="new-password" minlength="10" required />
              </div>
              <button type="submit" class="btn btn--red btn--wide">Set password</button>
              <p class="form-status" role="status" aria-live="polite" hidden></p>
            </form>
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="wrap">
          <div class="portal-grid">

            <div class="form-card">
              <h2>Sign in</h2>
              <form data-signin-form novalidate>
                <div class="field">
                  <label for="si-email">Email <span class="req">*</span></label>
                  <input type="email" id="si-email" name="email" autocomplete="email" required />
                </div>
                <div class="field">
                  <label for="si-password">Password <span class="req">*</span></label>
                  <input type="password" id="si-password" name="password" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn--red btn--wide">Sign in</button>
                <p class="form-note">
                  <button type="button" class="link-btn" data-forgot-toggle>Forgot your password?</button>
                </p>
                <p class="form-status" role="status" aria-live="polite" hidden></p>
              </form>

              <form data-forgot-form hidden novalidate>
                <div class="field">
                  <label for="fp-email">Email <span class="req">*</span></label>
                  <input type="email" id="fp-email" name="email" autocomplete="email" required />
                </div>
                <button type="submit" class="btn btn--outline btn--wide">Email me a reset link</button>
                <p class="form-status" role="status" aria-live="polite" hidden></p>
              </form>
            </div>

            <div class="form-card">
              <h2>Create an account</h2>
              <form data-signup-form novalidate>
                <div class="field">
                  <label for="su-name">Name <span class="req">*</span></label>
                  <input type="text" id="su-name" name="name" autocomplete="name" required />
                </div>
                <div class="field">
                  <label for="su-email">Email <span class="req">*</span></label>
                  <input type="email" id="su-email" name="email" autocomplete="email" required />
                </div>
                <div class="field">
                  <label for="su-password">Password <span class="req">*</span></label>
                  <input type="password" id="su-password" name="password" autocomplete="new-password" minlength="10" required />
                  <p class="form-note">At least 10 characters.</p>
                </div>
                <input type="hidden" name="role" value="client" />
                <button type="submit" class="btn btn--red btn--wide">Create account</button>
                <p class="form-note">
                  This creates a <strong>client</strong> portal account only - property owners and
                  managers requesting work. Vendor accounts aren't self-serve: apply at the
                  <a href="/vendor-network/">vendor network page</a> first. We review every
                  application, verify licence and insurance, and set up your portal login once
                  you're approved.
                </p>
                <p class="form-status" role="status" aria-live="polite" hidden></p>
              </form>
            </div>

          </div>
        </div>
      </section>
    )}

    <section class="section section--navy">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Prefer a person</p>
          <h2>Reach us directly</h2>
        </div>
        <p class="prose prose--left">
          Call <a href={SITE.telHref}>{SITE.phone}</a> for anything on a job already booked, or
          email <a href={SITE.mailtoHref}>{SITE.email}</a> for scheduling and invoices.
        </p>
      </div>
    </section>
  </BaseLayout>
)}

<script>
  import '../scripts/auth';
</script>
