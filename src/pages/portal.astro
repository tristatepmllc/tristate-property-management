---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { getAuth } from '../lib/auth';

/**
 * Real login, registration and a dashboard - replacing the holding page.
 * See README ("Header menus") for why a holding page existed at all: a Login
 * control that led to a form that could not authenticate anyone was worse
 * than no Login control.
 *
 * Session check runs server-side (this page is `prerender = false`, same as
 * the API routes) so the dashboard never flashes then disappears - the HTML
 * that reaches the browser already reflects whether anyone is signed in.
 *
 * `?reset=<token>` switches the page into "set a new password" mode. That
 * token comes from the email `sendResetPassword` in src/lib/auth.ts sends;
 * it is single-use and expires in one hour, both enforced by Better Auth.
 */
const session = await getAuth().api.getSession({ headers: Astro.request.headers });
const resetToken = Astro.url.searchParams.get('reset');

type Role = 'client' | 'vendor' | 'admin';
const user = session?.user as (typeof session extends null ? never : NonNullable<typeof session>['user']) & {
  role?: Role;
  company?: string | null;
  phone?: string | null;
  address?: string | null;
  city?: string | null;
  state?: string | null;
  zip?: string | null;
  propertyType?: string | null;
  preferredContact?: string | null;
  notes?: string | null;
  trade?: string | null;
  tradesOther?: string | null;
  serviceArea?: string | null;
  licenseNumber?: string | null;
  licenseExpires?: number | null;
  insuranceOnFile?: boolean | null;
  yearsInBusiness?: string | null;
  emergencyAvailable?: boolean | null;
} | undefined;

let balanceCents = 0;
let jobCount = 0;

if (session) {
  const [balanceRow, jobsRow] = await Promise.all([
    env.DB.prepare(`SELECT COALESCE(SUM(amount_cents), 0) AS cents FROM cashback_ledger WHERE account_id = ?1`)
      .bind(session.user.id)
      .first<{ cents: number }>(),
    env.DB.prepare(`SELECT COUNT(*) AS n FROM jobs WHERE account_id = ?1`)
      .bind(session.user.id)
      .first<{ n: number }>(),
  ]);
  balanceCents = balanceRow?.cents ?? 0;
  jobCount = jobsRow?.n ?? 0;
}

const balance = (balanceCents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
const roleLabel = user?.role === 'vendor' ? 'Vendor' : user?.role === 'admin' ? 'Admin' : 'Client';

// yyyy-mm-dd for <input type="date">, in the account's own stored value -
// not "today", so an empty field means "never set", not "expires today".
const licenseExpiresValue = user?.licenseExpires
  ? new Date(user.licenseExpires).toISOString().slice(0, 10)
  : '';
---
<BaseLayout
  title="Client and Vendor Portal - Tristate Property Management"
  description="Sign in to your Tristate account for job history and cashback balance, or register a new client or vendor account."
  path="/portal/"
  active="/portal/"
  noindex={true}
  showPopup={false}
>
  <section class="page-hero">
    <div class="page-hero-bg" style="background-image:url('/images/home-site-supervisor-reviewing-building-plans-on-.webp')"></div>
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <span>Portal</span></p>
      <h1>Portal</h1>
      <p>
        {session
          ? `Signed in as ${user?.name || user?.email}.`
          : 'Sign in to an existing account, or register a new one below.'}
      </p>
    </div>
  </section>

  {session ? (
    <section class="section">
      <div class="wrap">
        <div class="sec-head sec-head--form">
          <p class="eyebrow">{roleLabel} account</p>
          <h2>{user?.name || user?.email}</h2>
          <p>{user?.email}{user?.company ? ` \u00b7 ${user.company}` : ''}</p>
        </div>

        <div class="portal-grid">
          <div class="form-card">
            <h3>Cashback balance</h3>
            <p class="portal-figure">{balance}</p>
            <p class="form-note">
              Running total from the earn/redeem ledger. Nothing has posted to it yet for most
              accounts - that is expected until a completed job earns cashback.
            </p>
          </div>
          <div class="form-card">
            <h3>Jobs on file</h3>
            <p class="portal-figure">{jobCount}</p>
            <p class="form-note">
              {jobCount === 0
                ? 'No jobs recorded yet. This fills in once work is scheduled against your account.'
                : `${jobCount} job${jobCount === 1 ? '' : 's'} on record.`}
            </p>
          </div>
        </div>

        <div class="form-card form-card--wide">
          <h3>Profile</h3>
          <p class="form-note">
            Contact and {user?.role === 'vendor' ? 'trade' : 'property'} details we use when scheduling
            or matching work. Nothing here submits a new job or vendor application.
          </p>
          <form data-profile-form novalidate>
            <div class="portal-grid">
              <div class="field">
                <label for="pf-name">Name</label>
                <input type="text" id="pf-name" name="name" autocomplete="name" value={user?.name || ''} />
              </div>
              <div class="field">
                <label for="pf-company">Company</label>
                <input type="text" id="pf-company" name="company" autocomplete="organization" value={user?.company || ''} />
              </div>
              <div class="field">
                <label for="pf-phone">Phone</label>
                <input type="tel" id="pf-phone" name="phone" autocomplete="tel" value={user?.phone || ''} />
              </div>

              {user?.role === 'vendor' ? (
                <>
                  <div class="field">
                    <label for="pf-trade">Primary trade</label>
                    <select id="pf-trade" name="trade">
                      <option value="" selected={!user?.trade}>Select one</option>
                      <option value="cleaning" selected={user?.trade === 'cleaning'}>Cleaning</option>
                      <option value="plumbing" selected={user?.trade === 'plumbing'}>Plumbing</option>
                      <option value="electrical" selected={user?.trade === 'electrical'}>Electrical</option>
                      <option value="hvac" selected={user?.trade === 'hvac'}>HVAC</option>
                      <option value="handyman" selected={user?.trade === 'handyman'}>Handyman</option>
                      <option value="painting" selected={user?.trade === 'painting'}>Painting</option>
                      <option value="grounds" selected={user?.trade === 'grounds'}>Grounds</option>
                      <option value="projects" selected={user?.trade === 'projects'}>Projects</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="pf-trades-other">Secondary trades</label>
                    <input type="text" id="pf-trades-other" name="tradesOther" value={user?.tradesOther || ''} placeholder="e.g. drywall, tiling" />
                  </div>
                  <div class="field">
                    <label for="pf-service-area">Service area</label>
                    <input type="text" id="pf-service-area" name="serviceArea" value={user?.serviceArea || ''} placeholder="Towns or zip codes covered" />
                  </div>
                  <div class="field">
                    <label for="pf-license-number">License number</label>
                    <input type="text" id="pf-license-number" name="licenseNumber" value={user?.licenseNumber || ''} />
                  </div>
                  <div class="field">
                    <label for="pf-license-expires">License expires</label>
                    <input type="date" id="pf-license-expires" name="licenseExpires" value={licenseExpiresValue} />
                  </div>
                  <div class="field">
                    <label for="pf-years">Years in business</label>
                    <input type="text" id="pf-years" name="yearsInBusiness" value={user?.yearsInBusiness || ''} />
                  </div>
                  <div class="field field--checkbox">
                    <label>
                      <input type="checkbox" name="insuranceOnFile" checked={!!user?.insuranceOnFile} />
                      Current insurance on file
                    </label>
                  </div>
                  <div class="field field--checkbox">
                    <label>
                      <input type="checkbox" name="emergencyAvailable" checked={!!user?.emergencyAvailable} />
                      Available for emergency / after-hours calls
                    </label>
                  </div>
                </>
              ) : user?.role === 'client' ? (
                <>
                  <div class="field">
                    <label for="pf-address">Property address</label>
                    <input type="text" id="pf-address" name="address" autocomplete="street-address" value={user?.address || ''} />
                  </div>
                  <div class="field">
                    <label for="pf-city">City</label>
                    <input type="text" id="pf-city" name="city" autocomplete="address-level2" value={user?.city || ''} />
                  </div>
                  <div class="field">
                    <label for="pf-state">State</label>
                    <input type="text" id="pf-state" name="state" autocomplete="address-level1" value={user?.state || ''} />
                  </div>
                  <div class="field">
                    <label for="pf-zip">ZIP</label>
                    <input type="text" id="pf-zip" name="zip" autocomplete="postal-code" value={user?.zip || ''} />
                  </div>
                  <div class="field">
                    <label for="pf-property-type">Property type</label>
                    <select id="pf-property-type" name="propertyType">
                      <option value="" selected={!user?.propertyType}>Select one</option>
                      <option value="single_family" selected={user?.propertyType === 'single_family'}>Single-family</option>
                      <option value="multifamily" selected={user?.propertyType === 'multifamily'}>Multifamily</option>
                      <option value="commercial" selected={user?.propertyType === 'commercial'}>Commercial</option>
                      <option value="mixed_use" selected={user?.propertyType === 'mixed_use'}>Mixed-use</option>
                      <option value="other" selected={user?.propertyType === 'other'}>Other</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="pf-preferred-contact">Preferred contact method</label>
                    <select id="pf-preferred-contact" name="preferredContact">
                      <option value="" selected={!user?.preferredContact}>No preference</option>
                      <option value="email" selected={user?.preferredContact === 'email'}>Email</option>
                      <option value="phone" selected={user?.preferredContact === 'phone'}>Phone</option>
                      <option value="text" selected={user?.preferredContact === 'text'}>Text</option>
                    </select>
                  </div>
                  <div class="field field--wide">
                    <label for="pf-notes">Access notes / preferences</label>
                    <textarea id="pf-notes" name="notes" rows="3">{user?.notes || ''}</textarea>
                  </div>
                </>
              ) : null}
            </div>
            <button type="submit" class="btn btn--red">Save profile</button>
            <p class="form-status" role="status" aria-live="polite" hidden></p>
          </form>
        </div>

        <form id="logout-form" data-logout-form>
          <button type="submit" class="btn btn--outline">Sign out</button>
        </form>
      </div>
    </section>
  ) : resetToken ? (
    <section class="section">
      <div class="wrap">
        <div class="form-card form-card--narrow">
          <h2>Set a new password</h2>
          <form data-reset-form novalidate>
            <input type="hidden" name="token" value={resetToken} />
            <div class="field">
              <label for="p-new">New password <span class="req">*</span></label>
              <input type="password" id="p-new" name="password" autocomplete="new-password" minlength="10" required />
            </div>
            <button type="submit" class="btn btn--red btn--wide">Set password</button>
            <p class="form-status" role="status" aria-live="polite" hidden></p>
          </form>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        <div class="portal-grid">

          <div class="form-card">
            <h2>Sign in</h2>
            <form data-signin-form novalidate>
              <div class="field">
                <label for="si-email">Email <span class="req">*</span></label>
                <input type="email" id="si-email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="si-password">Password <span class="req">*</span></label>
                <input type="password" id="si-password" name="password" autocomplete="current-password" required />
              </div>
              <button type="submit" class="btn btn--red btn--wide">Sign in</button>
              <p class="form-note">
                <button type="button" class="link-btn" data-forgot-toggle>Forgot your password?</button>
              </p>
              <p class="form-status" role="status" aria-live="polite" hidden></p>
            </form>

            <form data-forgot-form hidden novalidate>
              <div class="field">
                <label for="fp-email">Email <span class="req">*</span></label>
                <input type="email" id="fp-email" name="email" autocomplete="email" required />
              </div>
              <button type="submit" class="btn btn--outline btn--wide">Email me a reset link</button>
              <p class="form-status" role="status" aria-live="polite" hidden></p>
            </form>
          </div>

          <div class="form-card">
            <h2>Create an account</h2>
            <form data-signup-form novalidate>
              <div class="field">
                <label for="su-name">Name <span class="req">*</span></label>
                <input type="text" id="su-name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="su-email">Email <span class="req">*</span></label>
                <input type="email" id="su-email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="su-password">Password <span class="req">*</span></label>
                <input type="password" id="su-password" name="password" autocomplete="new-password" minlength="10" required />
                <p class="form-note">At least 10 characters.</p>
              </div>
              <fieldset class="field">
                <legend>I am a...</legend>
                <label><input type="radio" name="role" value="client" checked /> Property owner (client)</label>
                <label><input type="radio" name="role" value="vendor" /> Trade partner (vendor)</label>
              </fieldset>
              <button type="submit" class="btn btn--red btn--wide">Create account</button>
              <p class="form-note">
                Registering here creates portal login credentials. It does not submit a job
                request or a vendor application - do that first at
                <a href="/client-registration/">client registration</a> or the
                <a href="/vendor-network/">vendor network page</a> if you have not already.
              </p>
              <p class="form-status" role="status" aria-live="polite" hidden></p>
            </form>
          </div>

        </div>
      </div>
    </section>
  )}

  <section class="section section--navy">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Prefer a person</p>
        <h2>Reach us directly</h2>
      </div>
      <p class="prose prose--left">
        Call <a href={SITE.telHref}>{SITE.phone}</a> for anything on a job already booked, or
        email <a href={SITE.mailtoHref}>{SITE.email}</a> for scheduling and invoices.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/auth';
</script>
