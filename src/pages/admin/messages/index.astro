---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/require-admin';
import { ensureChatSchema } from '../../../lib/chat';

/**
 * Live chat inbox (two-way). Left: conversations, newest activity first,
 * with unread counts. Right: the thread and a reply box. Replies appear in
 * the visitor's chat window on the website within ~3 seconds.
 *
 * The page renders the shell; src/scripts/admin-chat.ts loads and polls
 * /api/admin/chat (list, every 4s) and /api/admin/chat/[id] (open thread,
 * every 3s), plays a short sound and updates the tab title on new messages.
 *
 * Chats from before two-way chat existed are still leads with source
 * chat-widget - linked at the bottom.
 */
const admin = await requireAdmin(Astro.request.headers, 'messages');
if (!admin) return Astro.redirect('/tspm-admin', 302);

let legacy = 0;
try {
  await ensureChatSchema(env.DB);
  const r = await env.DB.prepare(
    `SELECT COUNT(*) AS n FROM leads l WHERE l.source = 'chat-widget'
       AND NOT EXISTS (SELECT 1 FROM chat_conversations c WHERE c.lead_id = l.id)`
  ).first<{ n: number }>();
  legacy = r?.n ?? 0;
} catch (e) {
  console.error('admin_chat_page_failed', String(e).slice(0, 300));
}
---
<AdminLayout title="Live chat" active="messages" admin={admin} heading="Live chat"
  subheading="Reply here and the visitor sees it on the website within seconds. New messages ping with a sound.">
  <div class="achat" data-chat-app data-me={(admin.name || admin.email).split(' ')[0]}>
    <aside class="achat-list">
      <div class="achat-tabs" role="tablist">
        <button type="button" class="adm-tab is-active" data-chat-filter="open">Open <span data-count-open>0</span></button>
        <button type="button" class="adm-tab" data-chat-filter="closed">Closed <span data-count-closed>0</span></button>
        <button type="button" class="adm-tab" data-chat-filter="all">All</button>
      </div>
      <div class="achat-items" data-chat-items>
        <p class="adm-muted achat-empty">Loading chats...</p>
      </div>
    </aside>

    <section class="achat-thread" data-chat-thread hidden>
      <header class="achat-head">
        <button type="button" class="achat-back" data-chat-back aria-label="Back to chats">&larr;</button>
        <span class="adm-person-photo" data-chat-initial>?</span>
        <div class="achat-who">
          <p class="adm-strong" data-chat-name></p>
          <p class="adm-muted" data-chat-meta></p>
        </div>
        <div class="adm-actions">
          <a class="btn btn--outline btn--sm" data-chat-call hidden>Call</a>
          <a class="btn btn--outline btn--sm" data-chat-lead hidden>Lead</a>
          <button type="button" class="btn btn--outline btn--sm" data-chat-toggle>Close chat</button>
        </div>
      </header>
      <div class="achat-msgs" data-chat-msgs aria-live="polite"></div>
      <form class="achat-compose" data-chat-compose>
        <textarea name="body" rows="1" placeholder="Type a reply... (Enter to send, Shift+Enter for a new line)" aria-label="Reply" maxlength="2000"></textarea>
        <button type="submit" class="btn btn--red">Send</button>
      </form>
    </section>

    <section class="achat-placeholder" data-chat-placeholder>
      <p class="adm-muted">Select a chat on the left to reply.</p>
    </section>
  </div>

  {legacy > 0 && (
    <p class="adm-note">{legacy} older chat message{legacy === 1 ? '' : 's'} from before two-way chat: <a class="adm-link" href="/admin/leads/?source=chat-widget">see them in Leads</a>.</p>
  )}
</AdminLayout>

<script>
  import '../../../scripts/admin-chat';
</script>
