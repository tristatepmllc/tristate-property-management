---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/require-admin';
import {
  etStartOfDay, etDayKey, etHour, fmtShortDay, fmtDateTime, fmtTime, relTime,
  sourceLabel, leadStatusLabel, leadStatusTone, LEAD_STATUSES, UNHANDLED, sinceSql,
} from '../../lib/admin';

/**
 * Admin overview - what anyone signing in needs to know in ten seconds:
 * how many leads came in (today / 7 days / 30 days, against the period
 * before), how many are still unhandled, chat messages, jobs with no
 * vendor, and where and when leads arrive. All times are US Eastern.
 *
 * Role-gate: non-admins are redirected to /portal/ with no message (same
 * posture as before - nothing reveals that an admin panel exists).
 */
const admin = await requireAdmin(Astro.request.headers);
if (!admin) return Astro.redirect('/portal/', 302);

const DAY = 86_400_000;
const now = Date.now();
const todayStart = etStartOfDay(now);
const yesterdayStart = etStartOfDay(todayStart - DAY / 2);

type LeadRow = {
  id: string; name: string; email: string; phone: string; service: string | null;
  source: string | null; status: string; created_at: number;
};
type Counts = {
  unhandled: number; chat_unread: number; jobs_open: number; jobs_no_vendor: number;
  jobs_pending: number; jobs_declined: number; invoices: number; vendor_apps: number;
  clients_new: number; clients_total: number; vendors_total: number;
};

let leads: LeadRow[] = [];
let counts: Counts = {
  unhandled: 0, chat_unread: 0, jobs_open: 0, jobs_no_vendor: 0, jobs_pending: 0, jobs_declined: 0,
  invoices: 0, vendor_apps: 0, clients_new: 0, clients_total: 0, vendors_total: 0,
};
let statusCounts: { status: string; n: number }[] = [];
let loadError = false;

try {
  const [l, c, s] = await Promise.all([
    env.DB.prepare(
      `SELECT id, name, email, phone, service, source, status, created_at
       FROM leads WHERE created_at >= ?1 ORDER BY created_at DESC LIMIT 5000`
    ).bind(now - 61 * DAY).all<LeadRow>(),
    env.DB.prepare(
      `SELECT
        (SELECT COUNT(*) FROM leads WHERE status IN ('needs_review','new') AND COALESCE(source,'') <> 'chat-widget') AS unhandled,
        (SELECT COUNT(*) FROM leads WHERE status IN ('needs_review','new') AND source = 'chat-widget') AS chat_unread,
        (SELECT COUNT(*) FROM jobs WHERE status NOT IN ('completed','cancelled')) AS jobs_open,
        (SELECT COUNT(*) FROM jobs WHERE status NOT IN ('completed','cancelled') AND vendor_response = 'unassigned') AS jobs_no_vendor,
        (SELECT COUNT(*) FROM jobs WHERE status NOT IN ('completed','cancelled') AND vendor_response = 'pending') AS jobs_pending,
        (SELECT COUNT(*) FROM jobs WHERE status NOT IN ('completed','cancelled') AND vendor_response = 'declined') AS jobs_declined,
        (SELECT COUNT(*) FROM jobs WHERE invoice_status = 'submitted') AS invoices,
        (SELECT COUNT(*) FROM vendors WHERE status IN ('needs_review','new','reviewing')) AS vendor_apps,
        (SELECT COUNT(*) FROM accounts WHERE role = 'client' AND ${sinceSql('created_at', '?1', '?2')}) AS clients_new,
        (SELECT COUNT(*) FROM accounts WHERE role = 'client') AS clients_total,
        (SELECT COUNT(*) FROM accounts WHERE role = 'vendor') AS vendors_total`
    ).bind(now - 7 * DAY, new Date(now - 7 * DAY).toISOString()).first<Counts>(),
    env.DB.prepare(`SELECT status, COUNT(*) AS n FROM leads GROUP BY status`).all<{ status: string; n: number }>(),
  ]);
  leads = l.results ?? [];
  if (c) counts = c;
  statusCounts = s.results ?? [];
} catch (e) {
  loadError = true;
  console.error('admin_overview_failed', String(e).slice(0, 300));
}

// ------------------------------------------------------------ aggregates
const inRange = (from: number, to = Infinity) => leads.filter((x) => x.created_at >= from && x.created_at < to);
const nonChat = (rows: LeadRow[]) => rows.filter((x) => x.source !== 'chat-widget');

const today = inRange(todayStart);
const yesterday = inRange(yesterdayStart, todayStart);
const last7 = inRange(now - 7 * DAY);
const prev7 = inRange(now - 14 * DAY, now - 7 * DAY);
const last30 = inRange(now - 30 * DAY);
const prev30 = inRange(now - 60 * DAY, now - 30 * DAY);
const chatToday = today.filter((x) => x.source === 'chat-widget');

const delta = (cur: number, prev: number) => {
  if (prev === 0) return cur === 0 ? { text: 'same as before', dir: '' } : { text: `+${cur} vs 0`, dir: 'up' };
  const pct = Math.round(((cur - prev) / prev) * 100);
  return { text: `${pct > 0 ? '+' : ''}${pct}% vs previous`, dir: pct > 0 ? 'up' : pct < 0 ? 'down' : '' };
};
const d1 = delta(nonChat(today).length, nonChat(yesterday).length);
const d7 = delta(nonChat(last7).length, nonChat(prev7).length);
const d30 = delta(nonChat(last30).length, nonChat(prev30).length);

// 30-day chart, one bar per ET day, oldest first.
const days = Array.from({ length: 30 }, (_, i) => {
  const ms = now - (29 - i) * DAY;
  return { key: etDayKey(ms), label: fmtShortDay(ms), n: 0 };
});
const dayIndex = new Map(days.map((d, i) => [d.key, i]));
for (const x of last30) {
  const i = dayIndex.get(etDayKey(x.created_at));
  if (i !== undefined) days[i].n++;
}
const dayMax = Math.max(1, ...days.map((d) => d.n));

// By source (30d)
const bySourceMap = new Map<string, number>();
for (const x of last30) {
  const k = sourceLabel(x.source);
  bySourceMap.set(k, (bySourceMap.get(k) ?? 0) + 1);
}
const bySource = [...bySourceMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
const sourceMax = Math.max(1, ...bySource.map((s) => s[1]));

// By hour of day (30d, ET)
const hours = Array.from({ length: 24 }, () => 0);
for (const x of last30) hours[etHour(x.created_at)]++;
const hourMax = Math.max(1, ...hours);
const peakHour = hours.indexOf(Math.max(...hours));
const hourLabel = (h: number) => `${h % 12 === 0 ? 12 : h % 12} ${h < 12 ? 'AM' : 'PM'}`;

// Pipeline
const statusN = (v: string) => statusCounts.find((s) => s.status === v)?.n ?? 0;

const latest = leads.slice(0, 10);

const attention = [
  { n: counts.unhandled, text: 'Leads not yet contacted', href: '/admin/leads/?status=open', tone: 'red' },
  { n: counts.chat_unread, text: 'Unread chat messages', href: '/admin/messages/', tone: 'red' },
  { n: counts.jobs_no_vendor, text: 'Jobs with no vendor assigned', href: '/admin/jobs/?stage=unassigned', tone: 'red' },
  { n: counts.jobs_declined, text: 'Jobs declined by a vendor - reassign', href: '/admin/jobs/?stage=declined', tone: 'red' },
  { n: counts.jobs_pending, text: 'Jobs waiting for the vendor to accept', href: '/admin/jobs/?stage=pending', tone: 'blue' },
  { n: counts.invoices, text: 'Vendor invoices to review', href: '/admin/jobs/?stage=invoice', tone: 'blue' },
  { n: counts.vendor_apps, text: 'Vendor applications to review', href: '/admin/vendors/', tone: 'blue' },
].filter((a) => a.n > 0);
---
<AdminLayout
  title="Overview"
  active="overview"
  admin={admin}
  heading={`Welcome back, ${(admin.name || admin.email).split(' ')[0]}`}
  subheading="Today at a glance. All times are US Eastern (ET)."
>
  {loadError && <p class="adm-banner">Some numbers could not load. Refresh in a moment; if it keeps happening, check the Cloudflare logs.</p>}

  <div class="adm-kpis">
    <a class="adm-kpi" href="/admin/leads/?range=today">
      <p class="adm-kpi-label">Leads today</p>
      <p class="adm-kpi-value">{nonChat(today).length}</p>
      <p class="adm-kpi-note"><span class={`adm-delta--${d1.dir}`}>{d1.text}</span></p>
    </a>
    <a class="adm-kpi" href="/admin/leads/?range=7d">
      <p class="adm-kpi-label">Last 7 days</p>
      <p class="adm-kpi-value">{nonChat(last7).length}</p>
      <p class="adm-kpi-note"><span class={`adm-delta--${d7.dir}`}>{d7.text}</span></p>
    </a>
    <a class="adm-kpi" href="/admin/leads/?range=30d">
      <p class="adm-kpi-label">Last 30 days</p>
      <p class="adm-kpi-value">{nonChat(last30).length}</p>
      <p class="adm-kpi-note"><span class={`adm-delta--${d30.dir}`}>{d30.text}</span></p>
    </a>
    <a class={`adm-kpi${counts.unhandled > 0 ? ' adm-kpi--alert' : ''}`} href="/admin/leads/?status=open">
      <p class="adm-kpi-label">Not contacted</p>
      <p class="adm-kpi-value">{counts.unhandled}</p>
      <p class="adm-kpi-note">{counts.unhandled > 0 ? 'Call these first' : 'All leads handled'}</p>
    </a>
    <a class={`adm-kpi${counts.chat_unread > 0 ? ' adm-kpi--alert' : ''}`} href="/admin/messages/">
      <p class="adm-kpi-label">Chat messages</p>
      <p class="adm-kpi-value">{chatToday.length}</p>
      <p class="adm-kpi-note">today &middot; {counts.chat_unread} unread</p>
    </a>
    <a class={`adm-kpi${counts.jobs_no_vendor + counts.jobs_declined > 0 ? ' adm-kpi--alert' : ''}`} href="/admin/jobs/">
      <p class="adm-kpi-label">Open jobs</p>
      <p class="adm-kpi-value">{counts.jobs_open}</p>
      <p class="adm-kpi-note">{counts.jobs_no_vendor + counts.jobs_declined} need a vendor</p>
    </a>
  </div>

  <div class="adm-grid-2">
    <div>
      <div class="adm-card">
        <div class="adm-card-head">
          <h2>Leads per day - last 30 days</h2>
          <span class="adm-muted">{last30.length} total incl. chat</span>
        </div>
        <div class="adm-bars" role="img" aria-label="Leads per day for the last 30 days">
          {days.map((d, i) => (
            <div class={`adm-bar${i === days.length - 1 ? ' is-today' : ''}`} title={`${d.label}: ${d.n} lead${d.n === 1 ? '' : 's'}`}>
              <em>{d.n}</em>
              <span style={`height:${Math.round((d.n / dayMax) * 100)}%`}></span>
            </div>
          ))}
        </div>
        <div class="adm-bars-axis"><span>{days[0].label}</span><span>{days[14].label}</span><span>Today</span></div>
      </div>

      <div class="adm-card">
        <div class="adm-card-head">
          <h2>Latest leads</h2>
          <a class="adm-link" href="/admin/leads/">All leads &rarr;</a>
        </div>
        {latest.length === 0 ? (
          <p class="adm-empty">No leads in the last 60 days.</p>
        ) : (
          <div class="adm-table-wrap">
            <table class="adm-table">
              <thead><tr><th>Received</th><th>Name</th><th>Service</th><th>Source</th><th>Status</th></tr></thead>
              <tbody>
                {latest.map((x) => (
                  <tr data-href={`/admin/leads/${x.id}`} class={UNHANDLED.includes(x.status) ? 'is-unread' : ''}>
                    <td class="adm-when"><b>{fmtTime(x.created_at)}</b><span>{relTime(x.created_at, now)}</span></td>
                    <td><span class="adm-strong">{x.name}</span><br /><a href={`tel:${x.phone}`}>{x.phone}</a></td>
                    <td>{x.service || <span class="adm-muted">-</span>}</td>
                    <td>{sourceLabel(x.source)}</td>
                    <td><span class={`adm-pill adm-pill--${leadStatusTone(x.status)}`}>{leadStatusLabel(x.status)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <div>
      <div class="adm-card">
        <h2>Needs attention</h2>
        {attention.length === 0 ? (
          <p class="adm-muted">Nothing waiting. Nice.</p>
        ) : (
          <div class="adm-funnel">
            {attention.map((a) => (
              <a href={a.href}>
                <span>{a.text}</span>
                <span class={`adm-pill adm-pill--${a.tone}`}>{a.n}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="adm-card">
        <h2>Where leads come from <span class="adm-muted">(30 days)</span></h2>
        {bySource.length === 0 ? (
          <p class="adm-muted">No leads yet.</p>
        ) : (
          <div class="adm-hbars">
            {bySource.map(([label, n]) => (
              <div class="adm-hbar">
                <span>{label}</span>
                <span class="adm-hbar-track"><span style={`width:${Math.round((n / sourceMax) * 100)}%`}></span></span>
                <b>{n}</b>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="adm-card">
        <h2>When leads arrive <span class="adm-muted">(ET, 30 days)</span></h2>
        <div class="adm-hours" role="img" aria-label="Leads by hour of day">
          {hours.map((n, h) => <div style={`height:${Math.round((n / hourMax) * 100)}%`} title={`${hourLabel(h)}: ${n}`}></div>)}
        </div>
        <div class="adm-hours-axis"><span>12 AM</span><span>6 AM</span><span>12 PM</span><span>6 PM</span></div>
        {last30.length > 0 && <p class="adm-note">Busiest hour: <b>{hourLabel(peakHour)} ET</b>. Have someone on the phones then.</p>}
      </div>

      <div class="adm-card">
        <h2>Lead pipeline <span class="adm-muted">(all time)</span></h2>
        <div class="adm-funnel">
          {LEAD_STATUSES.map((s) => (
            <a href={`/admin/leads/?status=${s.value}`}>
              <span>{s.label}</span>
              <span class={`adm-pill adm-pill--${s.tone}`}>{statusN(s.value)}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="adm-card">
        <h2>Accounts</h2>
        <dl class="adm-dl">
          <dt>Clients</dt><dd><a href="/admin/clients/">{counts.clients_total}</a> <span class="adm-muted">({counts.clients_new} new this week)</span></dd>
          <dt>Vendors</dt><dd><a href="/admin/vendors/?tab=accounts">{counts.vendors_total}</a></dd>
        </dl>
        <p class="adm-note">Updated {fmtDateTime(now)}</p>
      </div>
    </div>
  </div>
</AdminLayout>
