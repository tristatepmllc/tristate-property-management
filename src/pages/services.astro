---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SERVED_SENTENCE } from '../data/site';
import { SERVICE_CATALOG, MOST_REQUESTED, SERVICE_COUNT } from '../data/services-catalog';
import { graph, breadcrumbs, serviceList } from '../lib/schema';

/**
 * The full catalogue, rendered from src/data/services-catalog.ts. Every
 * service is its own H3 with its own one-line description so the exact
 * phrase people search for ("lockbox installation", "sprinkler
 * winterization") appears on the page with context, not as a keyword list.
 */
const catalogLd = {
  '@type': 'OfferCatalog',
  '@id': `${SITE.url}/services/#catalog`,
  name: 'Property maintenance services',
  itemListElement: SERVICE_CATALOG.map((c) => ({
    '@type': 'OfferCatalog',
    name: c.name,
    itemListElement: c.items.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i.name, description: i.blurb },
    })),
  })),
};
const jsonLd = graph([breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]), ...serviceList(), catalogLd]);
---
<BaseLayout
  title="Property Maintenance Services | Exterior, Interior, REO"
  description={`${SERVICE_COUNT}+ property maintenance services: lawn care, gutters, roofing, handyman, plumbing, electrical, HVAC, cleaning, REO preservation and 24/7 emergency response.`}
  path="/services/"
  active="/services/"
  jsonLd={jsonLd}
>
<!-- ================= PAGE HERO ================= -->
<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/images/home-plumbing.webp')"></div>
  <div class="wrap">
    <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <span>Services</span></p>
    <h1>Property maintenance services, inside and out</h1>
    <p>
      {SERVICE_COUNT}+ services across ten categories, for homeowners, landlords, investors,
      asset managers and commercial buildings in {SERVED_SENTENCE}. One work order, one
      point of contact, one invoice.
    </p>
    <div class="jump">
      {SERVICE_CATALOG.map((c) => <a href={`#${c.id}`}>{c.name.replace(/ \(.*\)$/, '')}</a>)}
    </div>
  </div>
</section>

<!-- ================= MOST REQUESTED ================= -->
<section class="section section--tight">
  <div class="wrap">
    <div class="sec-head sec-head--wide">
      <p class="eyebrow">Most requested</p>
      <h2>The 20 services property owners book most</h2>
      <p>The jobs that come through our dispatch desk every week. Tap one to jump to the details.</p>
    </div>
    <ol class="top-services">
      {MOST_REQUESTED.map((s, i) => (
        <li><a href={`#${s.anchor}`}><span class="top-services-n">{i + 1}</span>{s.name}</a></li>
      ))}
    </ol>
  </div>
</section>

<!-- ================= CATALOG ================= -->
<section class="section section--paper">
  <div class="wrap">
    <div class="catalog">
      {SERVICE_CATALOG.map((c) => (
        <div class="cat-block" id={c.id}>
          <div class="cat-head">
            <h2>{c.name}</h2>
            <span class="cat-count">{c.items.length} services</span>
            {c.detail && <a class="cat-more" href={c.detail.href}>Full details</a>}
          </div>
          <div class="cat-banner" style={`background-image:url('${c.image}')`}>
            <div class="cat-banner-text">
              <span class="cat-banner-kicker">{c.kicker}</span>
              <p>{c.intro}</p>
            </div>
          </div>
          <div class="svc-grid">
            {c.items.map((i) => (
              <article class="svc">
                <h3>{i.name}</h3>
                <p>{i.blurb}</p>
                {i.tag && <div class="svc-meta"><span class={`chip${i.tag === '24/7' ? ' chip--red' : ''}`}>{i.tag}</span></div>}
              </article>
            ))}
          </div>
          {c.detail && <p class="cat-detail-link"><a href={c.detail.href}>{c.detail.label} &rarr;</a></p>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================= SERVICE AREAS ================= -->
<section class="section section--tight">
  <div class="wrap">
    <div class="sec-head sec-head--wide">
      <p class="eyebrow">Where we work</p>
      <h2>Service areas</h2>
      <p>
        The same catalogue in every city we cover across {SERVED_SENTENCE}.
        <a href="/service-areas/">Find your city</a>.
      </p>
    </div>
  </div>
</section>

<!-- ================= NOT LISTED ================= -->
<section class="section">
  <div class="wrap">
    <div class="sec-head sec-head--wide">
      <p class="eyebrow">Not on the list?</p>
      <h2>Ask anyway</h2>
      <p>
        This page covers what we do most weeks, not everything we can do. If your building
        needs something unusual, send us a photo and we will tell you straight away whether
        it is ours or whether you need a specialist.
      </p>
      <div class="hero-actions">
        <a class="btn btn--red" href="/contact/">Describe your job</a>
        <a class="btn btn--outline" href={SITE.telHref}>Call {SITE.phone}</a>
      </div>
    </div>
  </div>
</section>

<section class="cta-band cta-band--photo cta-band--fractured">
  <div class="cta-bg" style="background-image:url('/images/services-landscaping-grounds-maintenance.webp')"></div>
  <svg class="cta-fracture" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon class="frac-plate" points="0,400 1440,400 1440,362 1306,382 1178,344 1012,370 872,322 706,346 566,300 432,324 268,270 176,292 0,262" />
    <path class="frac-line" d="M0,262 L176,292 L268,270 L432,324 L566,300 L706,346 L872,322 L1012,370 L1178,344 L1306,382 L1440,362" />
    <path class="frac-branch" d="M432,324 L466,262 L450,222" />
    <path class="frac-branch" d="M872,322 L842,380 L860,400" />
    <path class="frac-branch" d="M176,292 L152,350" />
    <path class="frac-branch" d="M1178,344 L1206,296" />
    <path class="frac-branch frac-branch--fine" d="M706,346 L680,394" />
    <path class="frac-branch frac-branch--fine" d="M566,300 L588,254" />
  </svg>
  <div class="wrap">
    <div class="cta-inner">
      <div>
        <h2>Get a written price today</h2>
        <p>Send us the job before noon and you will have a flat, itemised quote back the same working day.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--red" href="/contact/">Request a quote</a>
        <a class="btn btn--ghost" href="/why-tristate/">Why Tristate</a>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
