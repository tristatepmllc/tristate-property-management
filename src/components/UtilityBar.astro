---
import { SITE } from '../data/site';
---
<div class="utility">
  <div class="wrap">
    <div class="utility-left">
      <span class="util-emergency"><span class="pulse"></span>24/7 Emergency Response</span>
      <span class="util-hide">Licensed &amp; Insured{SITE.license ? ` \u00b7 ${SITE.license}` : ''}</span>
    </div>
    <div class="utility-right">
      <a class="util-hide" href={SITE.mailtoHref}>{SITE.email}</a>
      <a href="/contact/">Request a Quote</a>
    </div>
  </div>
</div>
