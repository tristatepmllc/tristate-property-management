---
/**
 * Phone-only sticky action bar: Call and Get a quote, always one tap away.
 * Hidden above 860px (desktop has the header buttons). "Get a quote" jumps
 * to the form already on the page when there is one (#hero-form, #quote),
 * otherwise opens /contact/.
 */
import { SITE } from '../data/site';
---
<nav class="sticky-cta" aria-label="Quick actions">
  <a class="sticky-cta-call" href={SITE.telHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    Call now
  </a>
  <a class="sticky-cta-quote" href="/contact/" data-sticky-quote>Get a free quote</a>
</nav>
<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-sticky-quote]');
  const target = document.getElementById('hero-form') ?? document.getElementById('quote');
  if (link && target) link.href = `#${target.id}`;
</script>
