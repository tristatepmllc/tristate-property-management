---
import { SITE } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<div class="chat-widget" data-chat="tristate" data-phone={SITE.phone}>
  <div class="chat-panel" role="dialog" aria-label="Live chat with Tristate" aria-hidden="true">
    <div class="chat-head">
      <span class="chat-avatar" aria-hidden="true">T</span>
      <span>
        <strong>Tristate Support</strong>
        <span class="status">Usually replies within minutes</span>
      </span>
    </div>

    <div class="chat-body">
      <span class="chat-time">Today</span>
      <div class="bubble them">Hi! Chat with the Tristate team right here. What can we help you with?</div>
      <div class="bubble them">Emergency? Call <strong>{SITE.phone}</strong> and we'll get a crew moving straight away.</div>
    </div>

    <div class="chat-chips">
      <button type="button" data-msg="I'd like a free quote">Get a quote</button>
      <button type="button" data-msg="Something is leaking right now">Emergency</button>
      <button type="button" data-msg="Do you cover my area?">Coverage</button>
    </div>

    <div class="chat-rec" data-chat-rec hidden>
      <span class="chat-rec-dot" aria-hidden="true"></span>
      <span class="chat-rec-time" data-chat-rec-time>0:00</span>
      <span class="chat-rec-label">Recording...</span>
      <button type="button" class="chat-rec-cancel" data-chat-rec-cancel>Cancel</button>
      <button type="button" class="chat-rec-send" data-chat-rec-send>Send</button>
    </div>

    <div class="chat-input">
      <button type="button" class="chat-tool" data-chat-attach aria-label="Send a photo" title="Send a photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/></svg>
      </button>
      <input type="file" accept="image/*" data-chat-file hidden />
      <input type="text" placeholder="Type your message&hellip;" aria-label="Type your message">
      <button type="button" class="chat-tool" data-chat-mic aria-label="Record a voice message" title="Voice message">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
      </button>
      <button type="button" class="chat-send" aria-label="Send message">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
      </button>
    </div>
    <div class="cf-turnstile chat-turnstile" data-sitekey={siteKey} data-size="flexible" data-appearance="interaction-only"></div>
    <p class="chat-foot">Live during business hours; we reply to every chat. Urgent? Call {SITE.phone}.</p>
  </div>

  <button type="button" class="chat-launcher" aria-label="Open live chat" aria-expanded="false">
    <span class="chat-badge" hidden aria-label="New messages">1</span>
    <svg class="ic-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.6L3 21l1.8-5A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z"/></svg>
    <svg class="ic-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
</div>

<script>
  import '../scripts/chat-widget';
</script>
