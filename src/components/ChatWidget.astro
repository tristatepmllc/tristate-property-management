---
import { SITE } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<div class="chat-widget" data-chat="tristate" data-phone={SITE.phone}>
  <div class="chat-panel" role="dialog" aria-label="Live chat with Tristate" aria-hidden="true">
    <div class="chat-head">
      <span class="chat-avatar" aria-hidden="true">T</span>
      <span>
        <strong>Tristate Support</strong>
        <span class="status">Messages go straight to dispatch</span>
      </span>
    </div>

    <div class="chat-body">
      <span class="chat-time">Today</span>
      <div class="bubble them">Hi &mdash; leave a message here and it goes straight to our dispatch desk. What&rsquo;s going on at your building?</div>
      <div class="bubble them">If it's an emergency, call <strong>{SITE.phone}</strong> and we'll get a crew moving straight away.</div>
    </div>

    <div class="chat-chips">
      <button type="button" data-msg="I'd like a quote for cleaning">Get a quote</button>
      <button type="button" data-msg="Something is leaking right now">Emergency</button>
      <button type="button" data-msg="Do you cover my area?">Coverage</button>
    </div>

    <div class="chat-input">
      <input type="text" placeholder="Type your message&hellip;" aria-label="Type your message">
      <button type="button" class="chat-send" aria-label="Send message">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
      </button>
    </div>
    <div class="cf-turnstile chat-turnstile" data-sitekey={siteKey} data-size="flexible" data-appearance="interaction-only"></div>
    <p class="chat-foot">Answered during business hours. For anything urgent, call {SITE.phone} &mdash; 24/7.</p>
  </div>

  <button type="button" class="chat-launcher" aria-label="Open live chat" aria-expanded="false">
    <span class="chat-badge">1</span>
    <svg class="ic-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.6L3 21l1.8-5A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z"/></svg>
    <svg class="ic-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('.chat-widget[data-chat="tristate"]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = "1";

  var panel    = root.querySelector(".chat-panel");
  var launcher = root.querySelector(".chat-launcher");
  var body     = root.querySelector(".chat-body");
  var input    = root.querySelector(".chat-input input");
  var send     = root.querySelector(".chat-send");
  var chips    = root.querySelector(".chat-chips");
  var PHONE    = root.dataset.phone || "";

  // Real lead capture, not a canned-reply mock. Three questions, then the
  // message is written to D1 through the same /api/leads endpoint the forms
  // use, tagged source=chat-widget.
  var state = { step: "message", message: "", name: "", contact: "", sent: false };
  var lastFocus = null;

  function bubble(text, who) {
    var el = document.createElement("div");
    el.className = "bubble " + (who || "them");
    el.textContent = text;
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
    return el;
  }

  function ask(text) {
    setTimeout(function () { bubble(text, "them"); }, 350);
  }

  function token() {
    var el = root.querySelector('input[name="cf-turnstile-response"]');
    return el ? el.value : "";
  }

  function submit() {
    if (state.sent) return;
    state.sent = true;
    var typing = bubble("Sending\u2026", "them");

    var isEmail = state.contact.indexOf("@") > -1;
    fetch("/api/leads", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        name: state.name,
        email: isEmail ? state.contact : "",
        phone: isEmail ? "" : state.contact,
        details: state.message,
        source: "chat-widget",
        service: "Chat enquiry",
        "cf-turnstile-response": token()
      })
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        typing.remove();
        if (res.ok) {
          bubble("Got it \u2014 that is with our dispatch desk now. Someone will come back to you, usually the same business day. If it cannot wait, call " + PHONE + ".", "them");
          if (window.turnstile) window.turnstile.reset();
        } else {
          bubble("Something went wrong sending that. Please call " + PHONE + " \u2014 the line is answered 24/7.", "them");
          state.sent = false;
        }
      })
      .catch(function () {
        typing.remove();
        bubble("No connection. Please call " + PHONE + " \u2014 answered 24/7.", "them");
        state.sent = false;
      });
  }

  function handle(text) {
    text = (text || "").trim();
    if (!text) return;
    bubble(text, "me");

    if (state.step === "message") {
      state.message = text;
      state.step = "name";
      ask("Thanks. What is your name?");
    } else if (state.step === "name") {
      state.name = text;
      state.step = "contact";
      ask("And the best number or email to reach you on?");
    } else if (state.step === "contact") {
      var digits = text.replace(/\D/g, "").length;
      if (text.indexOf("@") === -1 && digits < 7) {
        ask("That does not look like a phone number or an email \u2014 could you check it?");
        return;
      }
      state.contact = text;
      state.step = "done";
      if (chips) chips.style.display = "none";
      submit();
    } else {
      state.message += "\n" + text;
      state.sent = false;
      submit();
    }
  }

  function open() {
    lastFocus = document.activeElement;
    root.classList.add("is-open");
    launcher.setAttribute("aria-expanded", "true");
    panel.setAttribute("aria-hidden", "false");
    setTimeout(function () { input.focus(); }, 60);
  }
  function close() {
    root.classList.remove("is-open");
    launcher.setAttribute("aria-expanded", "false");
    panel.setAttribute("aria-hidden", "true");
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  launcher.addEventListener("click", function () {
    root.classList.contains("is-open") ? close() : open();
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && root.classList.contains("is-open")) close();
  });

  send.addEventListener("click", function () { handle(input.value); input.value = ""; });
  input.addEventListener("keydown", function (e) {
    if (e.key === "Enter") { e.preventDefault(); handle(input.value); input.value = ""; }
  });
  if (chips) {
    chips.addEventListener("click", function (e) {
      var b = e.target.closest("button");
      if (!b) return;
      handle(b.dataset.msg);
    });
  }
})();
</script>
