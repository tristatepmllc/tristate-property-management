---
import { SITE } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<!--
  Quote popup.
  Desktop : centre modal, 15s delay, exit-intent as a second chance.
  Mobile  : slim sticky bar (~11% of viewport, well under Google's ~30% ceiling
            for intrusive interstitials); tapping it opens the same modal, which
            makes the mobile modal click-triggered and therefore outside the
            interstitial guideline entirely.
  Hidden on /contact/ (the page already is the form) and after conversion.
-->
<div class="qp" data-quote-popup hidden>
  <!-- mobile teaser -->
  <div class="qp-bar" role="region" aria-label="Free building walk-through offer">
    <div class="qp-bar-text">
      <strong>Free building walk-through</strong>
      <span>Written maintenance plan, no obligation</span>
    </div>
    <button type="button" class="qp-bar-open">See details</button>
    <button type="button" class="qp-bar-close" aria-label="Dismiss offer">&times;</button>
  </div>

  <!-- modal -->
  <div class="qp-backdrop" data-qp-backdrop hidden>
    <div class="qp-modal" role="dialog" aria-modal="true" aria-labelledby="qp-title" aria-describedby="qp-desc">
      <button type="button" class="qp-close" aria-label="Close">&times;</button>

      <div class="qp-media" style="background-image:url('/images/home-site-supervisor-reviewing-building-plans-on-.webp')" aria-hidden="true"></div>

      <div class="qp-body">
        <p class="eyebrow">No cost, no obligation</p>
        <h2 id="qp-title">Free walk-through of your building</h2>
        <p id="qp-desc" class="qp-lede">
          A licensed technician walks your property, documents what needs attention now
          versus what can wait, and sends you a written maintenance plan with pricing.
          Takes about an hour. The plan is yours to keep either way.
        </p>

        <ul class="qp-points">
          <li>A written plan, not a sales pitch</li>
          <li>Usually scheduled within 3 business days</li>
          <li>Licensed, bonded &amp; insured</li>
        </ul>

        <form action="/api/leads" method="post" data-lead-form data-source="popup-walkthrough" novalidate>
          <input type="hidden" name="source" value="popup-walkthrough" />
          <input type="hidden" name="service" value="Free building walk-through" />
          <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
            <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="field">
            <label for="qp-name">Your name <span class="req">*</span></label>
            <input type="text" id="qp-name" name="name" autocomplete="name" placeholder="Jane Whitfield" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="qp-phone">Phone <span class="req">*</span></label>
              <input type="tel" id="qp-phone" name="phone" autocomplete="tel" placeholder="(203) 000-0000" required />
            </div>
            <div class="field">
              <label for="qp-email">Email <span class="req">*</span></label>
              <input type="email" id="qp-email" name="email" autocomplete="email" placeholder="jane@company.com" required />
            </div>
          </div>

          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-appearance="interaction-only"></div>

          <button type="submit" class="btn btn--red btn--wide">Book my free walk-through</button>
          <p class="form-status" role="status" aria-live="polite" hidden></p>

          <p class="qp-fine">
            We use this only to arrange the visit. No newsletters, no passing your details on.
          </p>
        </form>

        <p class="qp-alt">
          Something broken today? Call <a href={SITE.telHref}>{SITE.phone}</a> - answered 24/7.
        </p>

        <button type="button" class="qp-decline">No thanks</button>
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/quote-popup';
</script>
